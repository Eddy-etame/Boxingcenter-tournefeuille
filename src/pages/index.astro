---
/**
 * L'ACCUEIL — dans l'ordre des questions d'un Tournefeuillais.
 *
 * Ce site vise deux clubs, et c'est sa seule vraie question : lequel. La page
 * est donc une démonstration, pas une vitrine : la thèse (le héros), la règle
 * avec ses deux pièces (02), le reste du planning et le tableau où la colonne
 * vide désigne le club (03), la preuve interactive (04), le trajet — qui EST
 * le choix de club (05), le premier jour, le même quelle que soit la branche
 * (06), le cas par cas (07), la règle tenue depuis les communes voisines (08),
 * et la conclusion : réserver dans le club de sa discipline (09).
 *
 * Aucun titre de section n'existe sur un autre site de la famille. Chaque
 * nombre se compte depuis le registre. Chaque club est lu dans le graphe des
 * disciplines, jamais choisi ici.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Aiguillage from '../components/Aiguillage.astro';
import Seance from '../components/Seance.astro';
import Photo from '../components/Photo.astro';
import { SITE, CLUBS, VILLE, LIMITROPHES, NOTE_SECTEUR, type Club } from '../data/verite';
import { COMMUNES } from '../data/communes';
import {
  OFFRES,
  offresDeLaFamille,
  clubsQuiProposent,
  destinationUnique,
  FAMILLES_PAR_PAGE,
  type Famille,
} from '../data/offres';
import { ROLES } from '../data/medias';
import { route } from '../data/routes';
import { ITINERAIRES, itineraireDuClub, AVERTISSEMENT, enLettres } from '../data/transports';

const [SC, PT] = CLUBS;
const [PLAISANCE, FONSORBES] = COMMUNES;

/** Le club se lit dans le graphe, jamais dans une préférence. */
const CLUB_THAI = CLUBS.find((c) => c.id === destinationUnique('thai')) ?? SC;
const CLUB_MMA = CLUBS.find((c) => c.id === destinationUnique('mma')) ?? PT;

const VERS_SC = itineraireDuClub(SC.id) ?? ITINERAIRES[0];
const VERS_PT = itineraireDuClub(PT.id) ?? ITINERAIRES[1];
const dernier = (it: typeof VERS_SC) => it.etapes[it.etapes.length - 1];

/** Les familles, dans l'ordre où on les cherche, leur nom, et le mot court du titre. */
const FAMILLES: readonly { id: Famille; nom: string; court: string }[] = [
  { id: 'boxe-anglaise', nom: 'Boxe anglaise', court: 'boxe anglaise' },
  { id: 'thai', nom: 'Boxe thaï / K1', court: 'boxe thaï' },
  { id: 'kick-boxing', nom: 'Kick-boxing', court: 'kick-boxing' },
  { id: 'mma', nom: 'MMA', court: 'MMA' },
  { id: 'grappling', nom: 'Grappling & JJB', court: 'grappling' },
  { id: 'sparring', nom: 'Open Sparring', court: 'sparring' },
  { id: 'femme', nom: 'Entre femmes', court: 'entre femmes' },
  { id: 'physique', nom: 'Préparation physique', court: 'préparation physique' },
  { id: 'enfants', nom: 'Enfants et ados', court: 'enfants' },
];
type PageDiscipline = keyof typeof FAMILLES_PAR_PAGE;
const pageDe = (f: Famille) =>
  (Object.keys(FAMILLES_PAR_PAGE) as PageDiscipline[]).find((p) =>
    (FAMILLES_PAR_PAGE[p] as readonly Famille[]).includes(f)
  );
const intitules = (f: Famille, c: Club) =>
  offresDeLaFamille(f)
    .filter((o) => o.club === c.id)
    .map((o) => o.intitule);
const enumerer = (mots: string[]) =>
  mots.length > 1 ? `${mots.slice(0, -1).join(', ')} et ${mots[mots.length - 1]}` : mots[0] ?? '';
const majuscule = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const minuscule = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);

/** Les familles que les deux clubs publient : le titre de 03 s'écrit avec elles. */
const PARTAGEES = enumerer(
  FAMILLES.filter((f) => clubsQuiProposent(f.id).length === CLUBS.length).map((f) => f.court)
);

const MMA = OFFRES.find((o) => o.famille === 'mma');
const GRAPPLING = OFFRES.find((o) => o.famille === 'grappling');
const FEMME_SC = intitules('femme', SC)[0];
const FEMME_PT = intitules('femme', PT)[0];

/**
 * Le cas par cas. Chaque réponse s'ouvre sur un fait et finit par le nom d'un
 * club — la preuve, sous forme d'intitulés cités mot pour mot.
 */
const QUESTIONS = [
  {
    titre: `Où est le club de boxe le plus proche de ${SITE.ville} ?`,
    texte: `Il y en a deux, et ta discipline désigne le tien. ${SC.nom}, ${SC.adresse} : le Linéo ${VERS_SC.etapes[0].code} puis le métro ${VERS_SC.etapes[1].code}. ${PT.nom}, ${PT.adresse} : la ${VERS_PT.etapes[0].code} puis la ${VERS_PT.etapes[1].code}, ou la rocade et l’A64.`,
  },
  {
    titre: `Où faire de la boxe thaï près de ${SITE.ville} ?`,
    texte: `À ${CLUB_THAI.nom}, ${CLUB_THAI.adresse}. ${CLUB_THAI.singularite}`,
  },
  {
    titre: 'Il y a une vraie cage pour le MMA ?',
    texte: `Oui, à ${CLUB_MMA.nomCourt}. ${MMA?.intitule} : ${minuscule(MMA?.detail ?? '')} ${GRAPPLING?.intitule} : ${minuscule(GRAPPLING?.detail ?? '')}`,
  },
  {
    titre: 'Je débute complètement. Je peux venir ?',
    texte: `Oui, c’est le cas de la plupart des inscrits. La première séance se déroule de la même façon dans les deux clubs : de la corde, un geste décomposé lentement, le sac et les pattes d’ours. Elle se réserve sur le site de ${SC.nomCourt} ou sur celui de ${PT.nomCourt}.`,
  },
  {
    titre: 'Mon enfant peut s’inscrire ?',
    texte: `Dans les deux clubs. ${SC.nomCourt} publie ${enumerer(intitules('enfants', SC))} ; ${PT.nomCourt} publie ${enumerer(intitules('enfants', PT))}. Les âges exacts sont sur le planning de chaque club.`,
  },
  {
    titre: 'Je cherche un cours entre femmes.',
    texte: `${FEMME_SC} à ${SC.nomCourt}, ${FEMME_PT} à ${PT.nomCourt}. En Linéo et en métro, c’est ${SC.nomCourt} ; en voiture par la rocade, ${PT.nomCourt}.`,
  },
  {
    titre: 'Comment y aller sans voiture ?',
    texte: `${NOTE_SECTEUR} Pour ${PT.nomCourt}, la ${VERS_PT.etapes[0].code} rejoint ${VERS_PT.etapes[0].a}, où la ${VERS_PT.etapes[1].code} repart vers ${PT.ville} et s’arrête à « ${dernier(VERS_PT).a} ».`,
  },
];
---

<Base page="accueil" faq={QUESTIONS}>
  <Hero />

  {/* ─────────── 02 — LA RÈGLE ─────────── */}
  <section class="section regle" id="regle" aria-labelledby="t-regle">
    <div class="enveloppe">
      <p class="cartouche"><span class="cartouche__num">02</span><span>Lequel des deux</span></p>
      <div class="regle__tete">
        <h2 id="t-regle">
          La boxe thaï est à {CLUB_THAI.nomCourt}.<br />
          <span class="regle__accent">Le MMA en cage est à {CLUB_MMA.nomCourt}.</span>
        </h2>
        <p class="lead faible">
          Si tu cherches un club de boxe proche de {SITE.ville}, Boxing Center en a deux.
          La discipline désigne le club, parce que chacun publie sa propre liste de
          cours&nbsp;: tu regardes ce que tu cherches, et tu sais où aller.
        </p>
      </div>

      <Aiguillage />

      <ul class="clubs">
        {CLUBS.map((c, i) => {
          const it = itineraireDuClub(c.id);
          return (
            <li class="club reveler" style={`--retard:${i * 90}ms`} data-fiche-club={c.id}>
              <p class="mono club__cle">{c.nom}</p>
              <p class="club__adresse">{c.adresse}</p>
              <p class="club__horaires mono">{c.horairesCourt}</p>
              <p class="club__singularite">{c.singularite}</p>
              {it && (
                <p class="club__trajet">
                  {it.etapes.map((e, j) => (
                    <>
                      {j > 0 && <span class="club__puis" aria-hidden="true">→</span>}
                      <span class={`club__code club__code--${e.mode}`}>{e.code}</span>
                    </>
                  ))}
                  <span class="club__arrivee mono">{dernier(it).a}</span>
                </p>
              )}
              <a class="lien club__lien" href={c.site} rel="noopener">Le site de {c.nomCourt} ↗</a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  {/* ─────────── 03 — LE RESTE DU PLANNING ─────────── */}
  <section class="section encre cours" id="cours" aria-labelledby="t-cours">
    <div class="enveloppe">
      <p class="cartouche"><span class="cartouche__num">03</span><span>Le reste du planning</span></p>
      <div class="cours__tete">
        <h2 id="t-cours">
          {majuscule(PARTAGEES)}&nbsp;:<br />
          <span class="cours__accent">dans les deux clubs.</span>
        </h2>
        <p class="lead faible">
          Pour ces cours-là, le trajet décide&nbsp;: en Linéo et en métro, {SC.nomCourt}&nbsp;;
          en voiture, par la rocade ouest et l’A64, {PT.nomCourt}. Les sports de combat à
          proximité de {SITE.ville} tiennent dans un tableau&nbsp;: {enLettres(OFFRES.length)} intitulés,
          mot pour mot, dans la colonne du club qui les publie.
        </p>
      </div>

      <div class="tableau" role="region" aria-label="Qui publie quoi" tabindex="0">
        <table class="grille">
          <thead>
            <tr>
              <th scope="col">La discipline</th>
              {CLUBS.map((c) => <th scope="col">{c.nomCourt}</th>)}
            </tr>
          </thead>
          <tbody>
            {FAMILLES.map((f, i) => {
              const page = pageDe(f.id);
              const unique = destinationUnique(f.id);
              return (
                <tr class:list={['grille__ligne reveler', unique && 'grille__ligne--unique']} style={`--retard:${i * 40}ms`}>
                  <th scope="row">
                    {page ? <a class="grille__page" href={route(page).chemin}>{f.nom}</a> : f.nom}
                  </th>
                  {CLUBS.map((c) => {
                    const l = intitules(f.id, c);
                    const autre = CLUBS.find((x) => x.id !== c.id) ?? c;
                    return (
                      <td class:list={[l.length ? 'est-publie' : 'est-vide']}>
                        {l.length ? (
                          l.join(' · ')
                        ) : (
                          <>
                            <span aria-hidden="true">—</span>
                            <span class="vh">voir {autre.nomCourt}</span>
                          </>
                        )}
                      </td>
                    );
                  })}
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <p class="cours__sources mono">
        {CLUBS.map((c, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            <a class="lien" href={c.activites} rel="noopener">Toutes les activités de {c.nomCourt} ↗</a>
          </>
        ))}
      </p>
    </div>
  </section>

  {/* ─────────── 04 — LE MOTEUR ─────────── */}
  <Seance titre={'Choisis quoi et quand.\nLe club s’affiche, avec son planning.'} numero="04" />

  {/* ─────────── 05 — Y ALLER ─────────── */}
  <section class="section trajet" id="trajet" aria-labelledby="t-trajet">
    <div class="enveloppe trajet__inner">
      <div class="trajet__texte">
        <p class="cartouche"><span class="cartouche__num">05</span><span>Y aller</span></p>
        <h2 id="t-trajet">
          Pour {SC.nomCourt}, le {VERS_SC.etapes[0].code} puis le métro {VERS_SC.etapes[1].code}.<br />
          <span class="trajet__accent">Pour {PT.nomCourt}, la {VERS_PT.etapes[0].code} puis la {VERS_PT.etapes[1].code}.</span>
        </h2>
        <p class="lead faible">
          Les cours de boxe accessibles depuis {SITE.ville} en transports en commun sont au
          bout de {enLettres(ITINERAIRES.length)} trajets, et chaque trajet mène à un club.
          {' '}{NOTE_SECTEUR} La {VERS_PT.etapes[0].code} rejoint {VERS_PT.etapes[0].a}, où la
          {' '}{VERS_PT.etapes[1].code} repart vers {PT.ville} et s’arrête à «&nbsp;{dernier(VERS_PT).a}&nbsp;».
        </p>
        <p class="trajet__voiture mono">
          En voiture, pour {PT.nomCourt}&nbsp;: {minuscule(PT.acces.split('. ')[0])}.
        </p>
        <div class="trajet__actions">
          <a class="bouton bouton--signal" href={route('transports').chemin}>
            <span>Le trajet, arrêt par arrêt</span><span class="fleche" aria-hidden="true">→</span>
          </a>
          <a
            class="bouton"
            href={SC.plannings}
            rel="noopener"
            data-lien-club
            data-href-saint-cyprien={SC.plannings}
            data-href-portet={PT.plannings}
            data-nom-saint-cyprien={SC.nomCourt}
            data-nom-portet={PT.nomCourt}
          >
            <span>Le planning de <b data-nom-club>{SC.nomCourt}</b></span><span class="fleche" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="trajet__cote">
        <ol class="trajet__lignes">
          {ITINERAIRES.map((it, i) => {
            const c = CLUBS.find((x) => x.id === it.club) ?? SC;
            return (
              <li class="reveler" style={`--retard:${i * 90}ms`} data-fiche-club={it.club}>
                <a href={`${route('transports').chemin}?trajet=${it.id}`}>
                  <span class={`trajet__code trajet__code--${it.etapes[0].mode}`}>{it.etapes[0].code}</span>
                  <span class="trajet__parcours">{it.onglet}</span>
                  <span class="mono trajet__jours">vers {c.nomCourt} · {dernier(it).a}</span>
                </a>
              </li>
            );
          })}
        </ol>
        <p class="trajet__avertissement">{AVERTISSEMENT}</p>
      </div>
    </div>
  </section>

  {/* ─────────── 06 — LE PREMIER JOUR ─────────── */}
  <section class="section creuse premiere" id="premiere" aria-labelledby="t-premiere">
    <div class="enveloppe premiere__inner">
      <div class="premiere__image">
        <Photo slug={ROLES.premiereSeance} sizes="(max-width: 62rem) 100vw, 40vw" ratio="3 / 4" legende />
      </div>
      <div class="premiere__texte">
        <p class="cartouche"><span class="cartouche__num">06</span><span>La première fois</span></p>
        <h2 id="t-premiere">
          Ton premier jour&nbsp;: une tenue, de l’eau,<br />
          <span class="premiere__accent">et le sac de frappe. Pareil dans les deux clubs.</span>
        </h2>
        <p class="lead faible premiere__intro">
          Le premier jour dans un club de sport de combat se déroule de la même façon à
          {' '}{SC.nomCourt} et à {PT.nomCourt}, et la plupart des inscrits ont commencé par lui.
        </p>
        <ol class="premiere__etapes">
          <li>
            <span class="mono">01</span>
            <p><strong>Tu apportes une tenue de sport et de l’eau.</strong> Pour les gants et les bandes, tu demandes au club en arrivant.</p>
          </li>
          <li>
            <span class="mono">02</span>
            <p><strong>Tu frappes.</strong> De la corde, un geste décomposé lentement par le coach, du sac, puis les pattes d’ours.</p>
          </li>
          <li>
            <span class="mono">03</span>
            <p><strong>Chacun est occupé à sa propre séance.</strong> Le coach te suit, le reste de la salle a la tête dans son travail.</p>
          </li>
          <li>
            <span class="mono">04</span>
            <p><strong>Tu repars essoufflé, et content d’être venu.</strong> C’est le seul objectif d’une première séance.</p>
          </li>
        </ol>
        <div class="premiere__actions">
          <a
            class="bouton bouton--signal"
            href={`tel:${SC.telephoneLien}`}
            data-lien-club
            data-href-saint-cyprien={`tel:${SC.telephoneLien}`}
            data-href-portet={`tel:${PT.telephoneLien}`}
            data-nom-saint-cyprien={SC.nomCourt}
            data-nom-portet={PT.nomCourt}
          >
            <span>Appeler <b data-nom-club>{SC.nomCourt}</b> avant de venir</span><span class="fleche" aria-hidden="true">↗</span>
          </a>
          <a class="lien premiere__lien" href={route('premiere-seance').chemin}>
            Le déroulé complet, minute par minute →
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ─────────── 07 — CAS PAR CAS ─────────── */}
  <section class="section questions" id="questions" aria-labelledby="t-questions">
    <div class="enveloppe questions__inner">
      <div class="questions__tete">
        <p class="cartouche"><span class="cartouche__num">07</span><span>Cas par cas</span></p>
        <h2 id="t-questions">
          Enfant, débutant, boxe thaï, en bus&nbsp;:<br />
          <span class="questions__accent">le club à viser dans chaque cas.</span>
        </h2>
        <p class="lead faible">
          {majuscule(enLettres(QUESTIONS.length))} réponses courtes, et chacune finit par le
          nom d’un club. Si la tienne manque, écris-nous&nbsp;: on répond vite.
        </p>
      </div>
      <div class="questions__liste">
        {QUESTIONS.map((q, i) => (
          <details class="qr" open={i === 0}>
            <summary>
              <span class="qr__q">{q.titre}</span>
              <span class="qr__signe" aria-hidden="true"></span>
            </summary>
            <p class="qr__r">{q.texte}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ─────────── 08 — LE SECTEUR ─────────── */}
  <section class="section creuse secteur" id="secteur" aria-labelledby="t-secteur">
    <div class="enveloppe">
      <p class="cartouche"><span class="cartouche__num">08</span><span>Le secteur</span></p>
      <div class="secteur__tete">
        <h2 id="t-secteur">
          Depuis {PLAISANCE.nom}, le {PLAISANCE.cotes[1].valeur.split(',')[0]} démarre chez toi.<br />
          <span class="secteur__accent">Depuis {FONSORBES.nom}, la {FONSORBES.cotes[1].valeur}.</span>
        </h2>
        <p class="lead faible secteur__intro">
          {SITE.ville}, {VILLE.statut.valeur}, touche {enumerer(LIMITROPHES.map((l) => l.nom))}.
          {' '}{PLAISANCE.nom} et {FONSORBES.nom} ont chacune sa page&nbsp;: la ligne à prendre,
          la route, et le club au bout.
        </p>
      </div>

      <ul class="secteur__pages">
        {COMMUNES.map((c, i) => (
          <li class="reveler" style={`--retard:${i * 90}ms`}>
            <a class="carte" href={`/${c.id}/`}>
              <span class="mono carte__cp">{c.codePostal}</span>
              <span class="carte__nom">{c.nom}</span>
              <span class="carte__trajet">
                <span class="mono carte__ligne">{c.cotes[1].valeur}</span>
                <span aria-hidden="true">→</span>
                <span class="carte__club">{c.cotes[3].valeur}</span>
              </span>
              <span class="mono carte__aller">Le trajet depuis {c.nom} <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>

      <p class="mono secteur__cle">Les {enLettres(LIMITROPHES.length)} communes limitrophes de {SITE.ville}</p>
      <ul class="secteur__liste">
        {LIMITROPHES.map((c) => (
          <li class={c.note ? 'secteur__item secteur__item--cle' : 'secteur__item'}>
            <span class="secteur__nom">{c.nom}</span>
            {c.note && <span class="secteur__note">{c.note}</span>}
          </li>
        ))}
      </ul>
      <p class="secteur__pied">
        Boxing Center accueille les habitants de {SITE.ville} et de l’{SITE.secteur} dans ses
        clubs de {SC.nomCourt} et de {PT.nomCourt}. Accès par {VILLE.routes.valeur}&nbsp;; en
        transports, {VILLE.bus.valeur}.
      </p>
    </div>
  </section>

  {/* ─────────── 09 — DÉCIDER ─────────── */}
  <section class="section convergence" id="decider" aria-labelledby="t-convergence">
    <div class="enveloppe convergence__inner">
      <p class="cartouche"><span class="cartouche__num">09</span><span>Décider</span></p>
      <h2 id="t-convergence">
        Ta discipline a désigné ton club.<br />
        <span class="convergence__accent">Il te reste à réserver chez lui.</span>
      </h2>
      <p class="lead convergence__texte">
        La séance d’essai se réserve sur le site du club. Si tu hésites encore entre les
        deux, réponds aux deux questions du moteur, ou écris-nous en deux lignes&nbsp;: on
        te répond avec un créneau.
      </p>
      <div class="convergence__actions">
        {CLUBS.map((c) => (
          <a class="bouton bouton--signal" href={c.tarifs} rel="noopener">
            <span>Réserver à {c.nomCourt}</span><span class="fleche" aria-hidden="true">↗</span>
          </a>
        ))}
        <a class="bouton" href={route('contact').chemin}>
          <span>Poser ma question</span><span class="fleche" aria-hidden="true">→</span>
        </a>
      </div>
      <p class="convergence__lien">
        <a class="lien" href={route('quel-club').chemin}>La page qui compare les deux clubs, cours par cours →</a>
      </p>
    </div>
  </section>
</Base>

<style>
  /* ── 02 La règle ───────────────────────────────────────────────────── */
  .regle__tete {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--e-5) var(--e-8);
    align-items: end;
    margin-bottom: var(--e-7);
  }
  @media (max-width: 56rem) { .regle__tete { grid-template-columns: 1fr; gap: var(--e-4); margin-bottom: var(--e-5); } }
  .regle h2 { max-width: 18ch; }
  .regle__accent { color: var(--signal-texte); }
  .regle__tete .lead { max-width: 46ch; }

  .clubs {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: var(--e-5);
    margin-top: var(--e-7);
  }
  .club {
    display: grid;
    gap: var(--e-3);
    align-content: start;
    padding: var(--e-6);
    border-top: 2px solid var(--trait);
    background: var(--papier-vif);
    transition: border-color var(--d-normal) var(--e-sortie), background var(--d-normal) var(--e-sortie);
  }
  /* La fiche du club que le moteur a retenu prend le trait cuivre. */
  .club.est-retenu { border-top-color: var(--signal-texte); }
  .club__cle { color: var(--signal-texte); font-weight: 700; }
  .club__adresse { font-weight: 600; }
  .club__horaires { color: var(--graphite); text-transform: none; letter-spacing: 0.05em; }
