---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Seance from '../components/Seance.astro';
import Photo from '../components/Photo.astro';
import { SITE, CLUBS, VILLE, LIMITROPHES, CONTACT } from '../data/verite';
import { COMMUNES } from '../data/communes';
import { OFFRES } from '../data/offres';
import { ROLES } from '../data/medias';
import { route } from '../data/routes';
import { ITINERAIRES, MEILLEUR } from '../data/transports';

const [SC, PT] = CLUBS;

/**
 * Les questions telles qu'on les pose, avec des réponses courtes. Aucune n'est
 * là pour placer un mot-clé : chacune répond à quelque chose qu'on nous
 * demande vraiment.
 */
const QUESTIONS = [
  {
    titre: 'Où est le club de boxe le plus proche de Tournefeuille ?',
    texte:
      'Il y en a deux. Boxing Center Saint-Cyprien, au 11 rue Sainte-Lucie à Toulouse, à quatre minutes du métro A. Et Boxing Center Portet-sur-Garonne, au 61 route d’Espagne. Le premier se rejoint en Linéo L3 puis métro ; le second en voiture par la rocade, ou en bus.',
  },
  {
    titre: 'Lequel des deux choisir ?',
    texte:
      'Ce que tu cherches décide. La boxe thaï, le K1, l’Open Sparring et le cross-training sont à Saint-Cyprien. Le MMA en cage et le grappling sont à Portet. La boxe anglaise, les cours entre femmes et les cours enfants existent dans les deux.',
  },
  {
    titre: 'Où faire de la boxe thaï ?',
    texte:
      'À Saint-Cyprien, qui publie la Boxe Thaï / K1 et la présente comme sa discipline la plus complète : poings, jambes, genoux. C’est le seul club du réseau à la proposer.',
  },
  {
    titre: 'Et le MMA, il y a une vraie cage ?',
    texte:
      'Oui, à Portet-sur-Garonne, et l’entraînement se fait dedans. Le grappling et le jiu-jitsu brésilien y sont des cours à part, sans aucune frappe.',
  },
  {
    titre: 'Je n’ai jamais fait de sport de combat. Je peux venir ?',
    texte:
      'Oui, c’est le cas de la plupart des gens qui s’inscrivent. Pas de test à l’entrée, pas de niveau demandé. Une première séance, c’est de l’échauffement, un geste travaillé lentement, du sac et des pattes d’ours. Tu frappes, personne ne te frappe.',
  },
  {
    titre: 'Comment y aller sans voiture ?',
    texte:
      'Le Linéo L3 traverse Tournefeuille sur douze arrêts et finit aux Arènes. Le métro A y démarre et s’arrête deux stations plus loin, à Saint-Cyprien – République. Pour Portet, la 48 rejoint Basso Cambo et la 117 Express repart vers la route d’Espagne.',
  },
  {
    titre: 'Mon enfant peut s’inscrire ?',
    texte:
      'Oui, dans les deux clubs. Saint-Cyprien publie la Baby Boxe le samedi et la boxe éducative le mercredi et le samedi. Portet publie la Baby boxe, la boxe éducative et le kick-boxing enfants/ados. Tout se fait en touché contrôlé.',
  },
  {
    titre: 'J’habite Plaisance-du-Touch ou Fonsorbes.',
    texte:
      'Chaque commune a sa page ici, avec sa route et ses bus. Le Linéo L3 démarre à Plaisance Monestié ; depuis Fonsorbes, la ligne 116 rejoint Tournefeuille où la L3 prend le relais.',
  },
];
---

<Base page="accueil" faq={QUESTIONS}>
  <Hero />

  {/* ─────────── 02 — LES DEUX CLUBS ─────────── */}
  <section class="section clubs" aria-labelledby="t-clubs">
    <div class="enveloppe">
      <p class="cartouche"><span class="cartouche__num">02</span><span>Les deux clubs</span></p>
      <div class="clubs__tete">
        <h2 id="t-clubs">
          Deux salles,<br />
          <span class="clubs__accent">et pas les mêmes cours.</span>
        </h2>
        <p class="lead faible">
          C’est ce qui rend le choix simple : chaque club publie sa propre liste.
          Tu regardes ce que tu cherches, et tu sais où aller.
        </p>
      </div>

      <ul class="clubs__liste">
        {CLUBS.map((c, i) => (
          <li class="reveler" style={`--retard:${i * 90}ms`}>
            <p class="mono clubs__cle">{c.nom}</p>
            <p class="clubs__adresse">{c.adresse}</p>
            <p class="clubs__horaires mono">{c.horairesCourt}</p>
            <p class="clubs__angle">{c.angle}</p>
            <div class="clubs__actions">
              <a class="bouton bouton--signal" href={c.plannings} rel="noopener">
                <span>Le planning</span><span class="fleche" aria-hidden="true">↗</span>
              </a>
              <a class="bouton" href={c.site} rel="noopener">
                <span>Le site du club</span><span class="fleche" aria-hidden="true">↗</span>
              </a>
            </div>
          </li>
        ))}
      </ul>

      <Photo
        slug={ROLES.hero}
        sizes="100vw"
        ratio="21 / 9"
        legende
        class="clubs__image"
      />
    </div>
  </section>

  {/* ─────────── 03 — LE MOTEUR ─────────── */}
  <Seance />

  {/* ─────────── 04 — TOUT CE QUI SE PRATIQUE ─────────── */}
  <section class="section encre disciplines" aria-labelledby="t-disciplines">
    <div class="enveloppe">
      <p class="cartouche"><span class="cartouche__num">04</span><span>Tout ce qui se pratique</span></p>
      <div class="disciplines__tete">
        <h2 id="t-disciplines">Les cours, avec les noms<br />que tu verras sur le planning.</h2>
        <p class="lead faible disciplines__intro">
          Les intitulés au complet, répartis entre les deux clubs. Si un nom ne
          figure pas ici, c’est qu’il ne figure pas chez eux.
        </p>
      </div>

      {CLUBS.map((c) => (
        <div class="disciplines__club">
          <p class="mono disciplines__cle">{c.nom}</p>
          <ol class="disciplines__liste">
            {OFFRES.filter((o) => o.club === c.id).map((o, i) => (
              <li class="reveler" style={`--retard:${i * 40}ms`}>
                <span class="mono disc__num">{String(i + 1).padStart(2, '0')}</span>
                <div class="disc__corps">
                  <h3 class="disc__nom">{o.intitule}</h3>
                  <p class="disc__detail">{o.detail}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="disciplines__source mono">
            <a class="lien" href={c.activites} rel="noopener">Toutes les activités de {c.nomCourt} ↗</a>
          </p>
        </div>
      ))}
    </div>
  </section>

  {/* ─────────── 05 — LA SALLE ─────────── */}
  <section class="section preuve" aria-labelledby="t-preuve">
    <div class="enveloppe preuve__tete">
      <p class="cartouche"><span class="cartouche__num">05</span><span>Sur place</span></p>
      <h2 id="t-preuve">Voilà la salle.</h2>
      <p class="lead faible">
        Un mur de sacs, un ring, une cage, un plateau cardio. Toutes les photos
        de ce site ont été prises au club.
      </p>
    </div>
    <div class="enveloppe">
      <Photo slug={ROLES.signature} sizes="100vw" ratio="16 / 9" legende class="preuve__image" />
    </div>
  </section>

  {/* ─────────── 06 — LA PREMIÈRE SÉANCE ─────────── */}
  <section class="section creuse premiere" aria-labelledby="t-premiere">
    <div class="enveloppe premiere__inner">
      <div class="premiere__image">
        <Photo slug={ROLES.premiereSeance} sizes="(max-width: 62rem) 100vw, 40vw" ratio="3 / 4" />
      </div>
      <div class="premiere__texte">
        <p class="cartouche"><span class="cartouche__num">06</span><span>La première fois</span></p>
        <h2 id="t-premiere">Tout le monde a commencé par une première séance.</h2>
        <ol class="premiere__etapes">
          <li>
            <span class="mono">01</span>
            <p><strong>Tu apportes une tenue de sport et de l’eau.</strong> Rien de technique. Pour les gants et les bandes, demande au club en arrivant.</p>
          </li>
          <li>
            <span class="mono">02</span>
            <p><strong>Tu frappes, et c’est tout.</strong> Une première séance, c’est de la corde, un geste décomposé, du sac et des pattes d’ours.</p>
          </li>
          <li>
            <span class="mono">03</span>
            <p><strong>Chacun est occupé à sa propre séance.</strong> Le coach te suit, le reste de la salle a la tête dans son travail.</p>
          </li>
          <li>
            <span class="mono">04</span>
            <p><strong>Tu repars essoufflé, et content d’être venu.</strong> C’est le seul objectif d’une première séance.</p>
          </li>
        </ol>
        <a class="lien premiere__lien" href={route('premiere-seance').chemin}>
          Le déroulé complet, minute par minute →
        </a>
      </div>
    </div>
  </section>

  {/* ─────────── 07 — Y ALLER ─────────── */}
  <section class="section trajet" aria-labelledby="t-trajet">
    <div class="enveloppe trajet__inner">
      <div class="trajet__texte">
        <p class="cartouche"><span class="cartouche__num">07</span><span>Y aller</span></p>
        <h2 id="t-trajet">
          Le L3 descend aux Arènes,<br />
          <span class="trajet__accent">le métro fait le reste.</span>
        </h2>
        <p class="lead faible">{MEILLEUR.resume}</p>
        <div class="trajet__actions">
          <a class="bouton bouton--signal" href={route('transports').chemin}>
            <span>Le trajet, arrêt par arrêt</span><span class="fleche" aria-hidden="true">→</span>
          </a>
          <a class="bouton" href={SC.plannings} rel="noopener">
            <span>Le planning de {SC.nomCourt}</span><span class="fleche" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <ol class="trajet__lignes">
        {ITINERAIRES.map((it, i) => (
          <li class="reveler" style={`--retard:${i * 90}ms`}>
            <a href={`${route('transports').chemin}?trajet=${it.id}`}>
              <span class={`trajet__code trajet__code--${it.etapes[0].mode}`}>{it.etapes[0].code}</span>
              <span class="trajet__parcours">{it.onglet}</span>
              <span class="mono trajet__jours">vers {it.club === 'saint-cyprien' ? SC.nomCourt : PT.nomCourt}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ─────────── 08 — LES QUESTIONS ─────────── */}
  <section class="section creuse questions" aria-labelledby="t-questions">
    <div class="enveloppe questions__inner">
      <div class="questions__tete">
        <p class="cartouche"><span class="cartouche__num">08</span><span>Ce qu’on nous demande</span></p>
        <h2 id="t-questions">Les questions qu’on nous pose<br />le plus souvent.</h2>
        <p class="lead faible">
          Les réponses sont courtes. Si la tienne n’y est pas, écris-nous&nbsp;:
          on répond vite.
        </p>
      </div>
      <div class="questions__liste">
        {QUESTIONS.map((q, i) => (
          <details class="qr" open={i === 0}>
            <summary>
              <span class="qr__q">{q.titre}</span>
              <span class="qr__signe" aria-hidden="true"></span>
            </summary>
            <p class="qr__r">{q.texte}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ─────────── 09 — LE SECTEUR ─────────── */}
  <section class="section secteur" aria-labelledby="t-secteur">
    <div class="enveloppe">
      <p class="cartouche"><span class="cartouche__num">09</span><span>Le secteur</span></p>
      <div class="secteur__tete">
        <h2 id="t-secteur">
          Tu habites une commune à côté&nbsp;?<br />
          <span class="secteur__accent">On a prévu ça aussi.</span>
        </h2>
        <p class="lead faible secteur__intro">
          {VILLE.population.valeur.replace(' (2023)', '')}, dans Toulouse
          Métropole. Plaisance-du-Touch et Fonsorbes ont chacune sa page&nbsp;:
          la ligne à prendre, la route, et le club au bout.
        </p>
      </div>

      <ul class="secteur__pages">
        {COMMUNES.map((c) => (
          <li class="reveler">
            <a class="carte" href={`/${c.id}/`}>
              <span class="mono carte__cp">{c.codePostal}</span>
              <span class="carte__nom">{c.nom}</span>
              <span class="carte__trajet">
                <span class="mono carte__ligne">{c.cotes[1].valeur}</span>
                <span aria-hidden="true">→</span>
                <span class="carte__club">deux clubs</span>
              </span>
              <span class="mono carte__aller">Le trajet depuis {c.nom} <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>

      <p class="mono secteur__cle">Les quatre communes limitrophes de {SITE.ville}</p>
      <ul class="secteur__liste">
        {LIMITROPHES.map((c) => (
          <li class={c.note ? 'secteur__item secteur__item--cle' : 'secteur__item'}>
            <span class="secteur__nom">{c.nom}</span>
            {c.note && <span class="secteur__note">{c.note}</span>}
          </li>
        ))}
      </ul>
      <p class="secteur__pied">
        Boxing Center accueille les habitants de {SITE.ville} et de l’{SITE.secteur}
        dans deux clubs. Accès par {VILLE.routes.valeur}&nbsp;; en transports,
        {' '}{VILLE.bus.valeur}.
      </p>
    </div>
  </section>

  {/* ─────────── 10 — CONVERGENCE ─────────── */}
  <section class="section convergence" aria-labelledby="t-convergence">
    <div class="enveloppe convergence__inner">
      <p class="cartouche"><span class="cartouche__num">10</span><span>Décider</span></p>
      <h2 id="t-convergence">
        Deux clubs.<br />
        <span class="convergence__accent">Un seul qui te correspond.</span>
      </h2>
      <p class="lead convergence__texte">
        Réponds à deux questions et on te dit lequel viser et à quel moment
        venir. Si tu préfères demander, écris-nous en deux lignes&nbsp;: on te
        répond avec un créneau.
      </p>
      <div class="convergence__actions">
        <a class="bouton bouton--signal" href={route('quel-club').chemin}>
          <span>Trouver mon club</span><span class="fleche" aria-hidden="true">→</span>
        </a>
        <a class="bouton" href={route('contact').chemin}>
          <span>Poser ma question</span><span class="fleche" aria-hidden="true">→</span>
        </a>
        <a class="bouton" href={`tel:${CONTACT.telephoneLien.valeur}`}>
          <span>{CONTACT.telephone.valeur}</span><span class="fleche" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── 02 Les deux clubs ─────────────────────────────────────────────── */
  .clubs__tete {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--e-5) var(--e-8);
    align-items: end;
    margin-bottom: var(--e-7);
  }
  @media (max-width: 56rem) { .clubs__tete { grid-template-columns: 1fr; } }
  .clubs h2 { max-width: 14ch; }
  .clubs__accent { color: var(--signal-texte); }
  .clubs__tete .lead { max-width: 46ch; }

  .clubs__liste {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: var(--e-5);
    margin-bottom: var(--e-8);
  }
  .clubs__liste li {
    display: grid;
    gap: var(--e-3);
    align-content: start;
    padding: var(--e-6);
    border-top: 2px solid var(--signal);
    background: var(--papier-vif);
  }
  .clubs__cle { color: var(--signal-texte); font-weight: 700; }
  .clubs__adresse { font-weight: 600; }
  .clubs__horaires { color: var(--graphite); text-transform: none; letter-spacing: 0.05em; }
  .clubs__angle { font-size: var(--t-petit); color: var(--texte-faible); }
  .clubs__actions { display: flex; flex-wrap: wrap; gap: var(--e-2); margin-top: var(--e-3); }

  /* ── 04 Disciplines ────────────────────────────────────────────────── */
  .disciplines__tete {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--e-5) var(--e-8);
    align-items: end;
    margin-bottom: var(--e-7);
  }
  @media (max-width: 56rem) { .disciplines__tete { grid-template-columns: 1fr; } }
  .disciplines__intro { max-width: 46ch; }
  .disciplines__club + .disciplines__club { margin-top: var(--e-8); }
  .disciplines__cle { color: var(--signal-texte); margin-bottom: var(--e-4); }

  .disciplines__liste { list-style: none; }
  .disciplines__liste li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--e-4);
    align-items: baseline;
    padding: var(--e-4) 0;
    border-top: 1px solid var(--trait);
    transition: padding-left var(--d-normal) var(--e-sortie);
  }
  .disciplines__liste li:last-child { border-bottom: 1px solid var(--trait); }
  .disciplines__liste li:hover { padding-left: var(--e-3); }
  .disc__num { color: var(--signal-texte); font-weight: 700; }
  .disc__nom { font-size: var(--t-h3); margin-bottom: 0.2rem; }
  .disc__detail { font-size: var(--t-petit); color: var(--texte-faible); max-width: 56ch; }
  .disciplines__source { margin-top: var(--e-4); color: var(--graphite); text-transform: none; letter-spacing: 0.04em; }

  /* ── 05 Preuve ─────────────────────────────────────────────────────── */
  .preuve__tete { max-width: 56rem; margin-bottom: var(--e-7); }
  .preuve h2 { max-width: 18ch; margin-bottom: var(--e-4); }

  /* ── 06 Première séance ────────────────────────────────────────────── */
  .premiere__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--e-8);
    align-items: center;
  }
  @media (max-width: 62rem) { .premiere__inner { grid-template-columns: 1fr; } }
  .premiere h2 { max-width: 16ch; margin-bottom: var(--e-6); }
  .premiere__etapes { list-style: none; display: grid; }
  .premiere__etapes li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--e-4);
    padding: var(--e-4) 0;
    border-top: 1px solid var(--trait);
  }
  .premiere__etapes .mono { color: var(--signal-texte); padding-top: 0.3em; font-weight: 700; }
  .premiere__etapes p { font-size: var(--t-petit); color: var(--texte-faible); max-width: 56ch; }
  .premiere__etapes strong { color: var(--encre); font-weight: 600; }
  .premiere__lien { display: inline-block; margin-top: var(--e-5); font-size: var(--t-petit); }

  /* ── 07 Y aller ────────────────────────────────────────────────────── */
  .trajet__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: var(--e-8);
    align-items: center;
  }
  @media (max-width: 62rem) { .trajet__inner { grid-template-columns: 1fr; gap: var(--e-6); } }
  .trajet h2 { max-width: 16ch; margin-bottom: var(--e-4); }
  .trajet__accent { color: var(--signal-texte); }
  .trajet .lead { max-width: 50ch; }
  .trajet__actions { display: flex; flex-wrap: wrap; gap: var(--e-3); margin-top: var(--e-6); }

  .trajet__lignes { list-style: none; display: grid; gap: var(--e-3); }
  .trajet__lignes a {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: 'code parcours' 'code jours';
    gap: 0.15rem var(--e-4);
    align-items: center;
    padding: var(--e-4) var(--e-5);
    border: 1px solid var(--trait);
    border-radius: var(--rayon-1);
    background: var(--papier-vif);
    text-decoration: none;
    transition:
      border-color var(--d-rapide) var(--e-mecanique),
      transform var(--d-normal) var(--e-sortie);
  }
  .trajet__lignes a:hover { border-color: var(--signal-texte); transform: translateX(4px); }
  .trajet__code {
    grid-area: code;
    display: grid;
    place-items: center;
    min-width: 3.2rem;
    padding: 0.4rem 0.6rem;
    border-radius: 0.35rem;
    background: var(--encre);
    color: var(--papier-vif);
    font-family: var(--police-mono);
    font-size: var(--t-petit);
    font-weight: 700;
  }
  .trajet__code--metro { background: var(--signal-texte); }
  .trajet__parcours { grid-area: parcours; font-weight: 600; font-size: var(--t-petit); }
  .trajet__jours { grid-area: jours; color: var(--graphite); text-transform: none; letter-spacing: 0.05em; }

  /* ── 08 Questions ──────────────────────────────────────────────────── */
  .questions__inner {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: var(--e-8);
    align-items: start;
  }
  @media (max-width: 62rem) { .questions__inner { grid-template-columns: 1fr; gap: var(--e-6); } }
  .questions__tete h2 { max-width: 16ch; margin-bottom: var(--e-4); }
  .questions__tete .lead { max-width: 40ch; }

  /* ── 09 Secteur ────────────────────────────────────────────────────── */
  .secteur__tete {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--e-5) var(--e-8);
    align-items: end;
    margin-bottom: var(--e-7);
  }
  @media (max-width: 62rem) { .secteur__tete { grid-template-columns: 1fr; } }
  .secteur__accent { color: var(--signal-texte); }
  .secteur__intro { max-width: 48ch; }

  .secteur__pages {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--e-4);
    margin-bottom: var(--e-8);
  }
  .carte {
    display: grid;
    gap: 0.35rem;
    height: 100%;
    padding: var(--e-5);
    border: 1px solid var(--trait);
    border-radius: var(--rayon-1);
    background: var(--papier-vif);
    text-decoration: none;
    transition:
      border-color var(--d-rapide) var(--e-mecanique),
      transform var(--d-normal) var(--e-sortie);
  }
  .carte:hover { border-color: var(--signal-texte); transform: translateY(-3px); }
  .carte__cp { color: var(--graphite); }
  .carte__nom {
    font-family: var(--police-titre);
    font-size: var(--t-h3);
    font-weight: 700;
    letter-spacing: -0.015em;
  }
