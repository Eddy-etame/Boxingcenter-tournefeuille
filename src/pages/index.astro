<script>
  /**
   * Le club retenu par le moteur se lit partout où la page nomme un club :
   * la fiche et la carte de trajet prennent le trait, les portes « planning »
   * et « appeler » changent de destination. Le club vient de la barre de
   * parcours, jamais d'ici ; sans script, tout reste à Saint-Cyprien, le club
   * que les transports en commun desservent.
   */
  const camel = (id: string) => id.split('-').map((m) => m.charAt(0).toUpperCase() + m.slice(1)).join('');
  const suivre = () => {
    const club = document.querySelector<HTMLElement>('[data-parcours]')?.dataset.club ?? '';
    for (const el of document.querySelectorAll<HTMLElement>('[data-fiche-club]')) {
      el.classList.toggle('est-retenu', Boolean(club) && el.dataset.ficheClub === club);
    }
    if (!club) return;
    const cle = camel(club);
    for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-lien-club]')) {
      const href = a.dataset[`href${cle}`];
      const nom = a.dataset[`nom${cle}`];
      if (href) a.href = href;
      const cible = a.querySelector<HTMLElement>('[data-nom-club]');
      if (cible && nom) cible.textContent = nom;
    }
  };
  document.addEventListener('parcours:maj', suivre);
  suivre();
</script>
