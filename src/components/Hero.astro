---
/**
 * LE HERO — un écran, et deux portes de club dedans.
 *
 * Ce qu'il fait, dans l'ordre où un Tournefeuillais se pose les questions :
 * confirmer qu'il est au bon endroit (le H1), lui donner la raison de rester
 * (les disciplines), nommer les deux clubs avec le fait qui les distingue, et
 * ouvrir la porte de chacun avant le premier défilement.
 *
 * Deux portes, une par ligne du H1 : la boxe thaï réserve à Saint-Cyprien, le
 * MMA réserve à Portet. Le club n'est jamais choisi ici, il est lu dans le
 * graphe des disciplines — le même que celui du moteur.
 *
 * Le dessin de l'aiguillage vit une section plus bas, sous le titre qu'il
 * illustre : ici, il coûtait presque un écran avant le premier mot sur les
 * clubs. La ligne sous les portes y mène par une ancre.
 *
 * Le H1 est fixé par le cahier des charges : « club de MMA près de ».
 */
import { SITE, CLUBS } from '../data/verite';
import { OFFRES, offresDeLaFamille, destinationUnique, clubsQuiProposent, type Famille } from '../data/offres';
import { itineraireDuClub } from '../data/transports';

const [SC, PT] = CLUBS;

/** Les familles publiées, nommées comme dans les pages, dans l'ordre où on les cherche. */
const FAMILLES: readonly { id: Famille; nom: string }[] = [
  { id: 'boxe-anglaise', nom: 'boxe anglaise' },
  { id: 'thai', nom: 'boxe thaï' },
  { id: 'kick-boxing', nom: 'kick-boxing' },
  { id: 'mma', nom: 'MMA' },
  { id: 'grappling', nom: 'grappling' },
  { id: 'enfants', nom: 'cours enfants' },
];
const enumerer = (mots: string[]) =>
  mots.length > 1 ? `${mots.slice(0, -1).join(', ')} et ${mots[mots.length - 1]}` : mots[0] ?? '';
const majuscule = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const DISCIPLINES = enumerer(FAMILLES.filter((f) => offresDeLaFamille(f.id).length).map((f) => f.nom));

/** Les familles que les deux clubs publient : pour elles, le trajet décide. */
const PARTAGEES = enumerer(
  (
    [
      { id: 'boxe-anglaise', nom: 'boxe anglaise' },
      { id: 'kick-boxing', nom: 'kick-boxing' },
      { id: 'enfants', nom: 'enfants' },
      { id: 'femme', nom: 'entre femmes' },
    ] as const
  )
    .filter((f) => clubsQuiProposent(f.id).length === CLUBS.length)
    .map((f) => f.nom)
);

/** Le club se lit dans le graphe, jamais dans une préférence. */
const CLUB_THAI = CLUBS.find((c) => c.id === destinationUnique('thai')) ?? SC;
const CLUB_MMA = CLUBS.find((c) => c.id === destinationUnique('mma')) ?? PT;
const MMA = OFFRES.find((o) => o.famille === 'mma');
const METRO = itineraireDuClub(CLUB_THAI.id)?.etapes.find((e) => e.mode === 'metro');
---

<section class="hero" aria-labelledby="t-hero">
  <div class="enveloppe">
    <p class="hero__cartouche mono">
      <span class="hero__planche">Boxing Center</span>
      <span aria-hidden="true">·</span>
      <span>à proximité de {SITE.ville}</span>
    </p>

    <div class="hero__texte">
      <h1 id="t-hero" class="hero__titre">
        <span class="hero__ligne">Ton club de MMA</span>
        <span class="hero__ligne">et de boxe thaï</span>
        <span class="hero__ligne hero__ligne--accent">près de {SITE.ville}.</span>
      </h1>

      <p class="hero__promesse">
        <strong>{majuscule(DISCIPLINES)}, dans deux clubs.</strong>
        La boxe thaï se pratique à {CLUB_THAI.nomCourt},
        {METRO ? `à ${METRO.precision.split(',')[0]} de métro des ${METRO.de}` : `à ${CLUB_THAI.ville}`}.
        Le MMA se pratique à {CLUB_MMA.nomCourt}, {MMA?.detail.includes('cage') ? 'dans la cage' : `à ${CLUB_MMA.ville}`}.
      </p>

      <p class="hero__cotes mono">
        <span class="hero__cote"><b>{SC.nomCourt}</b> {SC.horairesCourt}</span>
        <span class="hero__cote"><b>{PT.nomCourt}</b> {PT.horairesCourt}</span>
      </p>

      <div class="hero__actions">
        <a class="bouton bouton--signal" href={CLUB_THAI.tarifs} rel="noopener">
          <span>Réserver ma séance de boxe thaï</span>
          <span class="fleche" aria-hidden="true">↗</span>
        </a>
        <a class="bouton bouton--signal" href={CLUB_MMA.tarifs} rel="noopener">
          <span>Réserver ma séance de MMA</span>
          <span class="fleche" aria-hidden="true">↗</span>
        </a>
      </div>

      <p class="hero__reste">
        {majuscule(PARTAGEES)}&nbsp;: dans les deux clubs.
        <a class="lien" href="#regle">Lequel est le mien&nbsp;↓</a>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2rem, 1rem + 4vw, 4.5rem) clamp(2.5rem, 1.5rem + 4vw, 5rem);
    background: var(--papier);
    overflow: hidden;
  }

  /* Le papier a un grain de calque : des lignes de trame très pâles. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, var(--trait-faible) 1px, transparent 1px),
      linear-gradient(to bottom, var(--trait-faible) 1px, transparent 1px);
    background-size: 3.5rem 3.5rem;
    mask-image: radial-gradient(120% 90% at 50% 45%, #000 0%, transparent 78%);
    opacity: 0.55;
  }
  .hero > * { position: relative; }

  .hero__cartouche {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    align-items: center;
    padding-bottom: var(--e-4);
    border-bottom: 1px solid var(--trait);
    margin-bottom: var(--e-7);
  }
  .hero__planche { color: var(--signal-texte); font-weight: 700; }

  .hero__texte { max-width: 62rem; }

  .hero__titre { max-width: 15ch; margin-bottom: var(--e-5); }
  /* La signature du site : chaque ligne se dévoile par le bas, comme une
     branche qui se trace — le même geste que l'aiguillage. */
  .hero__ligne { display: block; animation: poser 820ms var(--e-sortie) both; }
  .hero__ligne:nth-child(1) { animation-delay: 0ms; }
  .hero__ligne:nth-child(2) { animation-delay: 150ms; }
  .hero__ligne:nth-child(3) { animation-delay: 300ms; }
  .hero__ligne--accent { color: var(--signal-texte); }
  @keyframes poser {
    from { opacity: 0; clip-path: inset(0 0 100% 0); transform: translateY(0.25em); }
    to { opacity: 1; clip-path: inset(0 0 -12% 0); transform: none; }
  }
  @keyframes venir {
    from { opacity: 0; transform: translateY(0.4em); }
    to { opacity: 1; transform: none; }
  }

  .hero__promesse {
    max-width: 56ch;
    font-size: var(--t-lead);
    line-height: 1.45;
    color: var(--texte-faible);
    padding-left: var(--e-5);
    border-left: 2px solid var(--signal);
    animation: venir 720ms var(--e-sortie) 450ms both;
  }
  .hero__promesse strong { color: var(--encre); font-weight: 600; }

  .hero__cotes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2) var(--e-5);
    margin-top: var(--e-5);
    padding-left: calc(var(--e-5) + 2px);
    color: var(--graphite);
    text-transform: none;
    letter-spacing: 0.05em;
    animation: venir 720ms var(--e-sortie) 580ms both;
  }
  .hero__cote b { color: var(--encre); font-weight: 700; margin-right: 0.35em; }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    margin-top: var(--e-6);
    animation: venir 720ms var(--e-sortie) 700ms both;
  }

  .hero__reste {
    margin-top: var(--e-4);
    font-size: var(--t-petit);
    color: var(--texte-faible);
    animation: venir 720ms var(--e-sortie) 820ms both;
  }
  .hero__reste .lien { color: var(--signal-texte); white-space: nowrap; }

  /* Sur téléphone, le héros tient dans l'écran : la section 02 commence juste après. */
  @media (max-width: 48rem) {
    .hero { padding-block: 1.75rem 2rem; }
    .hero__cartouche { margin-bottom: var(--e-6); }
  }

  :global(.no-js) .hero__ligne,
  :global(.no-js) .hero__promesse,
  :global(.no-js) .hero__cotes,
  :global(.no-js) .hero__actions,
  :global(.no-js) .hero__reste { animation: none; opacity: 1; transform: none; clip-path: none; }

  @media (prefers-reduced-motion: reduce) {
    .hero__ligne,
    .hero__promesse,
    .hero__cotes,
    .hero__actions,
    .hero__reste { animation: none !important; opacity: 1; transform: none; clip-path: none; }
  }
</style>
