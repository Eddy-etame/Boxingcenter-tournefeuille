---
/**
 * LE HERO — « l'aiguillage ».
 *
 * Tournefeuille est le seul site du réseau à viser deux clubs. Le dessin dit
 * donc exactement ça : une route qui part de la ville, un aiguillage, et deux
 * branches. Celle du haut monte vers Saint-Cyprien en métro ; celle du bas
 * descend vers Portet en bus.
 *
 * La branche que le moteur a retenue s'allume. Tant que le visiteur n'a rien
 * décidé, les deux restent au trait : le site ne choisit pas à sa place, il
 * attend de savoir ce qu'il cherche.
 *
 * Tout est en SVG inline — aucun canvas, aucune bibliothèque, aucune requête.
 * Sans JavaScript et en mouvement réduit, le plan est déjà à son état final.
 * Deux tracés existent, horizontal et vertical.
 */
import { SITE, CLUBS, club } from '../data/verite';
import { route } from '../data/routes';

const [SC, PT] = CLUBS;
---

<section class="hero" aria-labelledby="t-hero">
  <div class="enveloppe">
    <p class="hero__cartouche mono">
      <span class="hero__planche">Boxing Center</span>
      <span aria-hidden="true">·</span>
      <span>à proximité de {SITE.ville}</span>
    </p>

    <div class="hero__haut">
      <div class="hero__texte">
        <h1 id="t-hero" class="hero__titre">
          <span class="hero__ligne">Ton club de MMA</span>
          <span class="hero__ligne">et de boxe thaï</span>
          <span class="hero__ligne hero__ligne--accent">près de {SITE.ville}.</span>
        </h1>

        <p class="hero__promesse">
          <strong>Boxe anglaise, boxe thaï, K1, MMA, grappling et cours enfants.</strong>
          Deux salles autour de chez toi&nbsp;: l’une à quatre minutes du métro A,
          l’autre avec la seule cage du réseau. Tu peux venir sans avoir jamais
          boxé.
        </p>

        <div class="hero__actions">
          <a class="bouton bouton--signal" href={route('quel-club').chemin}>
            <span>Trouver mon club</span>
            <span class="fleche" aria-hidden="true">→</span>
          </a>
          <a class="bouton" href={route('transports').chemin}>
            <span>Y aller sans voiture</span>
            <span class="fleche" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <dl class="hero__faits">
        {CLUBS.map((c) => (
          <div>
            <dt class="mono">{c.nomCourt}</dt>
            <dd>{c.horairesCourt}</dd>
          </div>
        ))}
        <div>
          <dt class="mono">Depuis {SITE.ville}</dt>
          <dd>
            <a class="hero__fait-lien" href={route('transports').chemin}>
              {SITE.accesCourt}<span class="fleche" aria-hidden="true">→</span>
            </a>
          </dd>
        </div>
      </dl>
    </div>
  </div>

  {/* ─────────────── LE PLAN ─────────────── */}
  <div class="enveloppe">
    <figure class="plan" data-plan>
      <figcaption class="vh">
        Depuis Tournefeuille (31170), deux clubs Boxing Center : Saint-Cyprien,
        11 rue Sainte-Lucie à Toulouse, ouvert de {club('saint-cyprien').ouvertureTexte} à {club('saint-cyprien').fermetureTexte} du lundi au samedi,
        à quatre minutes du métro A ; et Portet-sur-Garonne, 61 route d’Espagne,
        ouvert de {club('portet').ouvertureTexte} à {club('portet').fermetureTexte}, 600 m² avec un ring et une cage MMA.
      </figcaption>

      {/* ── Tracé horizontal — écrans larges ── */}
      <svg
        class="plan__svg plan__svg--h"
        viewBox="0 0 1200 440"
        role="img"
        aria-hidden="true"
        preserveAspectRatio="xMidYMid meet"
      >
        {/* Le tronc commun, puis les deux branches. */}
        <path class="plan__trait" d="M 180 240 H 560" fill="none" />
        <path class="plan__trait" d="M 560 240 L 1010 130" fill="none" />
        <path class="plan__trait" d="M 560 240 L 1010 360" fill="none" />

        {/* Les tracés vifs : celui du club retenu s'allume. */}
        <path class="plan__tronc" d="M 180 240 H 560" fill="none" pathLength="100" />
        <path
          class="plan__branche plan__branche--saint-cyprien"
          d="M 560 240 L 1010 130"
          fill="none"
          pathLength="100"
        />
        <path
          class="plan__branche plan__branche--portet"
          d="M 560 240 L 1010 360"
          fill="none"
          pathLength="100"
        />

        {/* Cote — la branche du haut */}
        <g class="plan__cote" style="--rang:1">
          <path class="plan__cote-ligne" d="M 790 185 V 108" />
          <path class="plan__cote-tick" d="M 782 108 H 798" />
          <text class="plan__cote-texte" x="790" y="92" text-anchor="middle">
            Linéo L3, puis métro A
          </text>
        </g>

        {/* Cote — la branche du bas */}
        <g class="plan__cote" style="--rang:2">
          <path class="plan__cote-ligne" d="M 790 300 V 378" />
          <path class="plan__cote-tick" d="M 782 378 H 798" />
          <text class="plan__cote-texte" x="790" y="400" text-anchor="middle">
            Bus 48, puis 117 Express
          </text>
        </g>

        {/* L'aiguillage : le point où la question se tranche. */}
        <g class="plan__aiguillage">
          <circle class="plan__aiguillage-rond" cx="560" cy="240" r="13" />
          <path class="plan__aiguillage-croix" d="M 560 220 V 260 M 540 240 H 580" />
          <text class="plan__aiguillage-nom" x="560" y="292" text-anchor="middle">
            CE QUE TU CHERCHES
          </text>
        </g>

        {/* Nœud d'origine */}
        <g class="plan__noeud plan__noeud--origine">
          <circle cx="180" cy="240" r="7" />
          <text class="plan__noeud-nom" x="180" y="272" text-anchor="middle">TOURNEFEUILLE</text>
          <text class="plan__noeud-cp" x="180" y="290" text-anchor="middle">31170</text>
        </g>

        {/* Les deux destinations */}
        <g class="plan__noeud plan__noeud--fin plan__noeud--saint-cyprien">
          <circle class="plan__cible" cx="1010" cy="130" r="15" />
          <circle cx="1010" cy="130" r="6" />
          <text class="plan__noeud-nom" x="1010" y="98" text-anchor="middle">SAINT-CYPRIEN</text>
          <text class="plan__noeud-cp" x="1010" y="172" text-anchor="middle">Boxe thaï · K1</text>
        </g>
        <g class="plan__noeud plan__noeud--fin plan__noeud--portet">
          <circle class="plan__cible" cx="1010" cy="360" r="15" />
          <circle cx="1010" cy="360" r="6" />
          <text class="plan__noeud-nom" x="1010" y="402" text-anchor="middle">PORTET-SUR-GARONNE</text>
          <text class="plan__noeud-cp" x="1010" y="420" text-anchor="middle">MMA en cage · grappling</text>
        </g>
      </svg>

      {/* ── Tracé vertical — téléphones ── */}
      <svg
        class="plan__svg plan__svg--v"
        viewBox="0 0 360 620"
        role="img"
        aria-hidden="true"
        preserveAspectRatio="xMidYMid meet"
      >
        <path class="plan__trait" d="M 180 96 V 290" fill="none" />
        <path class="plan__trait" d="M 180 290 L 84 470" fill="none" />
        <path class="plan__trait" d="M 180 290 L 276 470" fill="none" />

        <path class="plan__tronc" d="M 180 96 V 290" fill="none" pathLength="100" />
        <path
          class="plan__branche plan__branche--saint-cyprien"
          d="M 180 290 L 84 470"
          fill="none"
          pathLength="100"
        />
        <path
          class="plan__branche plan__branche--portet"
          d="M 180 290 L 276 470"
          fill="none"
          pathLength="100"
        />

        <g class="plan__cote" style="--rang:1">
          <path class="plan__cote-ligne" d="M 132 380 H 44" />
          <path class="plan__cote-tick" d="M 44 372 V 388" />
          <text class="plan__cote-texte" x="40" y="362" text-anchor="start">L3 + métro A</text>
        </g>
        <g class="plan__cote" style="--rang:2">
          <path class="plan__cote-ligne" d="M 228 380 H 316" />
          <path class="plan__cote-tick" d="M 316 372 V 388" />
          <text class="plan__cote-texte" x="320" y="362" text-anchor="end">48 + 117 Express</text>
        </g>

        <g class="plan__aiguillage">
          <circle class="plan__aiguillage-rond" cx="180" cy="290" r="13" />
          <path class="plan__aiguillage-croix" d="M 180 270 V 310 M 160 290 H 200" />
          <text class="plan__aiguillage-nom" x="180" y="256" text-anchor="middle">
            CE QUE TU CHERCHES
          </text>
        </g>

        <g class="plan__noeud plan__noeud--origine">
          <circle cx="180" cy="96" r="7" />
          <text class="plan__noeud-nom" x="180" y="66" text-anchor="middle">TOURNEFEUILLE</text>
          <text class="plan__noeud-cp" x="180" y="46" text-anchor="middle">31170</text>
        </g>

        <g class="plan__noeud plan__noeud--fin plan__noeud--saint-cyprien">
          <circle class="plan__cible" cx="84" cy="470" r="14" />
          <circle cx="84" cy="470" r="6" />
          <text class="plan__noeud-nom" x="84" y="510" text-anchor="middle">SAINT-CYPRIEN</text>
          <text class="plan__noeud-cp" x="84" y="528" text-anchor="middle">Boxe thaï · K1</text>
        </g>
        <g class="plan__noeud plan__noeud--fin plan__noeud--portet">
          <circle class="plan__cible" cx="276" cy="470" r="14" />
          <circle cx="276" cy="470" r="6" />
          <text class="plan__noeud-nom" x="276" y="510" text-anchor="middle">PORTET</text>
          <text class="plan__noeud-cp" x="276" y="528" text-anchor="middle">MMA · grappling</text>
        </g>
      </svg>

      <div class="plan__bloc mono">
        <span><b>{SITE.ville}</b> → deux clubs</span>
        <span>Boxing Center</span>
        <span class="plan__bloc-src">{SC.adresse} · {PT.adresse}</span>
      </div>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2rem, 1rem + 4vw, 4.5rem) clamp(3rem, 2rem + 4vw, 5rem);
    background: var(--papier);
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, var(--trait-faible) 1px, transparent 1px),
      linear-gradient(to bottom, var(--trait-faible) 1px, transparent 1px);
    background-size: 3.5rem 3.5rem;
    mask-image: radial-gradient(120% 90% at 50% 45%, #000 0%, transparent 78%);
    opacity: 0.55;
  }
  .hero > * { position: relative; }

  .hero__cartouche {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    align-items: center;
    padding-bottom: var(--e-4);
    border-bottom: 1px solid var(--trait);
    margin-bottom: var(--e-7);
  }
  .hero__planche { color: var(--signal-texte); font-weight: 700; }

  .hero__haut {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    gap: var(--e-6) var(--e-8);
    align-items: end;
  }
  @media (max-width: 62rem) {
    .hero__haut { grid-template-columns: 1fr; align-items: start; }
  }

  .hero__titre { max-width: 15ch; margin-bottom: var(--e-5); }
  .hero__ligne { display: block; animation: poser 720ms var(--e-sortie) both; }
  .hero__ligne:nth-child(1) { animation-delay: 0ms; }
  .hero__ligne:nth-child(2) { animation-delay: 150ms; }
  .hero__ligne:nth-child(3) { animation-delay: 300ms; }
  .hero__ligne { animation-duration: 820ms; }
  .hero__ligne--accent { color: var(--signal-texte); }
  @keyframes poser {
    from { opacity: 0; clip-path: inset(0 0 100% 0); transform: translateY(0.25em); }
    to { opacity: 1; clip-path: inset(0 0 -12% 0); transform: none; }
  }

  .hero__promesse {
    max-width: 54ch;
    font-size: var(--t-lead);
    line-height: 1.45;
    color: var(--texte-faible);
    padding-left: var(--e-5);
    border-left: 2px solid var(--signal);
  }
  .hero__promesse strong { color: var(--encre); font-weight: 600; }

  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--e-3); margin-top: var(--e-6); }

  .hero__faits { display: grid; gap: 0; margin: 0; }
  .hero__faits > div {
    display: grid;
    gap: 0.15rem;
    padding: var(--e-3) 0;
    border-top: 1px solid var(--trait);
  }
  .hero__faits > div:last-child { border-bottom: 1px solid var(--trait); }
  .hero__faits dt { color: var(--graphite); }
  .hero__faits dd { margin: 0; font-size: var(--t-petit); font-weight: 600; }
  .hero__fait-lien {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    color: var(--signal-texte);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--d-rapide) var(--e-mecanique);
  }
  .hero__fait-lien:hover { border-color: currentColor; }

  /* ── Le plan ───────────────────────────────────────────────────────── */
  .plan { position: relative; margin: var(--e-8) 0 0; }
  .plan__svg { width: 100%; height: auto; overflow: visible; }
  .plan__svg--v { display: none; }
  @media (max-width: 48rem) {
    .plan__svg--h { display: none; }
    .plan__svg--v { display: block; max-width: 22rem; margin-inline: auto; }
  }

  .plan__trait {
    stroke: var(--graphite);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    opacity: 0.45;
  }

  /* Le tronc se trace toujours : il est acquis avant toute décision. */
  .plan__tronc {
    stroke: var(--signal-texte);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    fill: none;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: tracer 900ms var(--e-resolution) 200ms forwards;
  }
  @keyframes tracer { to { stroke-dashoffset: 0; } }

  /* Les branches attendent. Celle du club retenu s'allume, l'autre s'estompe. */
  .plan__branche {
    stroke: var(--signal-texte);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    fill: none;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    opacity: 0.55;
    transition:
      stroke-dashoffset var(--d-trace) var(--e-resolution),
      opacity var(--d-normal) var(--e-sortie);
    animation: tracer 900ms var(--e-resolution) 900ms forwards;
  }
  .plan[data-club='saint-cyprien'] .plan__branche--portet,
  .plan[data-club='portet'] .plan__branche--saint-cyprien { opacity: 0.14; }
  .plan[data-club='saint-cyprien'] .plan__branche--saint-cyprien,
  .plan[data-club='portet'] .plan__branche--portet { opacity: 1; stroke-width: 3; }

  /* Le nœud du club retenu grossit ; l'autre s'efface sans disparaître. */
  .plan__noeud--fin { transition: opacity var(--d-normal) var(--e-sortie); }
  .plan[data-club='saint-cyprien'] .plan__noeud--portet,
  .plan[data-club='portet'] .plan__noeud--saint-cyprien { opacity: 0.3; }

  .plan__cote {
    opacity: 0;
    animation: apparaitre 420ms var(--e-sortie) forwards;
    animation-delay: calc(1500ms + var(--rang) * 130ms);
  }
  @keyframes apparaitre { to { opacity: 1; } }

  .plan__cote-ligne,
  .plan__cote-tick {
    stroke: var(--graphite);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    fill: none;
    opacity: 0.7;
  }
  .plan__cote-ligne { stroke-dasharray: 4 4; }
  .plan__cote-texte {
    font-family: var(--police-mono);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.06em;
    fill: var(--signal-texte);
  }

  /* L'aiguillage : le point où la question se tranche. */
  .plan__aiguillage {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: poser-aiguillage 520ms var(--e-mecanique) 1200ms forwards;
  }
  @keyframes poser-aiguillage {
    from { opacity: 0; transform: scale(1.9); }
    to { opacity: 1; transform: scale(1); }
  }
  .plan__aiguillage-rond {
    fill: var(--papier);
    stroke: var(--encre);
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
  }
  .plan__aiguillage-croix {
    stroke: var(--encre);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    fill: none;
    opacity: 0.75;
  }
  .plan__aiguillage-nom {
    font-family: var(--police-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    fill: var(--graphite);
  }

  .plan__noeud circle { fill: var(--encre); }
  .plan__noeud {
    opacity: 0;
    animation: apparaitre 380ms var(--e-sortie) forwards;
  }
  .plan__noeud--origine { animation-delay: 900ms; }
  .plan__noeud--fin { animation-delay: 1700ms; }

  .plan__cible {
    fill: none;
    stroke: var(--signal-texte);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    transform-box: fill-box;
    transform-origin: center;
    animation: viser 2.6s var(--e-mecanique) 2s infinite;
  }
  @keyframes viser {
    0%, 72%, 100% { transform: scale(1); opacity: 1; }
    84% { transform: scale(1.28); opacity: 0.35; }
  }
  .plan__noeud--fin circle:last-of-type { fill: var(--signal-texte); }

  .plan__noeud-nom {
    font-family: var(--police-mono);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.12em;
    fill: var(--encre);
  }
  .plan__noeud-cp {
    font-family: var(--police-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    fill: var(--graphite);
  }

  .plan__bloc {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2) var(--e-5);
    margin-top: var(--e-5);
    padding-top: var(--e-3);
    border-top: 1px solid var(--trait);
    text-transform: none;
    letter-spacing: 0.05em;
    color: var(--graphite);
  }
  .plan__bloc b { color: var(--encre); font-weight: 700; }
  .plan__bloc-src { margin-left: auto; }
  @media (max-width: 62rem) { .plan__bloc-src { margin-left: 0; } }

  /* ── Sans script, et en mouvement réduit : le plan est déjà fini. ──── */
  :global(.no-js) .plan__cote,
  :global(.no-js) .plan__noeud,
  :global(.no-js) .plan__aiguillage,
  :global(.no-js) .hero__ligne { animation: none; opacity: 1; }
  :global(.no-js) .plan__aiguillage { transform: none; }
  :global(.no-js) .plan__tronc,
  :global(.no-js) .plan__branche { stroke-dashoffset: 0; animation: none; }

  @media (prefers-reduced-motion: reduce) {
    .plan__cote,
    .plan__noeud,
    .plan__aiguillage,
    .plan__cible,
    .hero__ligne { animation: none !important; opacity: 1; }
    .plan__aiguillage { transform: none; }
    .plan__tronc,
    .plan__branche { stroke-dashoffset: 0; animation: none; }
  }
</style>

<script>
  /**
   * La branche du club retenu s'allume. Le club vient du moteur, jamais d'ici :
   * on ne fait que lire l'attribut que la barre de parcours porte déjà.
   */
  const plan = document.querySelector<HTMLElement>('[data-plan]');
  if (plan) {
    const suivre = () => {
      const barre = document.querySelector<HTMLElement>('[data-parcours]');
      const club = barre?.dataset.club ?? '';
      if (club) plan.dataset.club = club;
      else delete plan.dataset.club;
    };
    document.addEventListener('parcours:maj', suivre);
    suivre();
  }
</script>
